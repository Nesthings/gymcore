# Environment
# API
APP_NAME=GymCore API
ENV=development
DEBUG=true
BACKEND_PORT=8002

# Database (PostgreSQL via docker-compose)
POSTGRES_USER=gymcore
POSTGRES_PASSWORD=gymcore_dev
POSTGRES_DB=gymcore
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://gymcore:gymcore_dev@localhost:5434/gymcore

# Auth (JWT propio)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Super-admin (dueño del producto)
SUPER_ADMIN_EMAIL=admin@gymcore.app
SUPER_ADMIN_PASSWORD=change-me-in-production
SUPER_ADMIN_NAME=Super Admin

# Storage de media (MVP local → Cloudflare R2 cuando haya credenciales)
MEDIA_ROOT=media
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# WhatsApp Business (Meta Cloud API)
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=gymcore-verify-2026

# Cola de mensajes (Amazon SQS)
SQS_QUEUE_URL=
SQS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP (envío de correos)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Mercado Pago (pasarela de pagos)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Motor de riesgo de abandono: barrido periódico (segundos; 0 = desactivado)
RISK_SWEEP_SECONDS=1800